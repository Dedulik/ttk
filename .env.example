# Регистрация посетителей (роль «посетитель», без доступа к админке): 1 — включена, 0 — выключена
ALLOW_REGISTRATION=1
# Приглашения сотрудников: срок жизни ссылки (часы) и адрес сайта для ссылки в письме
INVITE_TTL_HOURS=72
PUBLIC_URL=
# Почта для писем-приглашений. Не задана — админ получает ссылку и передаёт её сам
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=0
