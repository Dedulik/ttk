# Скопируйте в .env и поменяйте значения перед запуском на сервере
SECRET_KEY=поменяйте-на-длинную-случайную-строку
ADMIN_EMAIL=admin@arena.local
ADMIN_PASSWORD=admin12345
SEED_DEMO_USERS=1
TOKEN_TTL_MIN=720
MAX_UPLOAD_MB=15
# Если фронтенд открыт с другого адреса (например, GitHub Pages), перечислите его через запятую
CORS_ORIGINS=
