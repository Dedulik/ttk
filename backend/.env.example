# Скопируйте в .env и поменяйте значения перед запуском на сервере
# Если не задать, сервер сам создаст случайный ключ в data/secret.key
SECRET_KEY=поменяйте-на-длинную-случайную-строку
# Сколько автоматических копий базы хранить в data/backups (0 — не делать)
BACKUP_KEEP=10
ADMIN_EMAIL=admin@arena.local
# Не задан — сервер при первом запуске придумает пароль и запишет в data/admin-password.txt
ADMIN_PASSWORD=
# 1 — создать учебные записи editor@ / viewer@ (только для демонстрации)
SEED_DEMO_USERS=0
TOKEN_TTL_MIN=720
MAX_UPLOAD_MB=15
# Если фронтенд открыт с другого адреса (например, GitHub Pages), перечислите его через запятую
CORS_ORIGINS=
# Регистрация посетителей (роль «посетитель», без доступа к админке): 1 — включена, 0 — выключена
ALLOW_REGISTRATION=1
# Приглашения сотрудников: срок жизни ссылки (часы) и адрес сайта для ссылки в письме
INVITE_TTL_HOURS=72
PUBLIC_URL=
# Почта для писем-приглашений. Не задана — админ получает ссылку и передаёт её сам
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=0
